# BarangayLink environment settings
# Copy this file to .env and fill in your own values.
# Never commit .env — it is ignored by .gitignore.

# --- Database ---
# Remove a line to use its default: localhost / root / (empty) / barangay_system_test_environment
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=barangay_system_test_environment

# --- SMS (httpSMS) ---
# API key from your httpSMS account. Leave blank to turn SMS off (sends are skipped).
HTTPSMS_API_KEY=
# Phone number registered in the httpSMS app, international format (e.g. +639XXXXXXXXX).
HTTPSMS_FROM_NUMBER=
# SIM used by the httpSMS phone: SIM1 or SIM2. Defaults to SIM1 if blank.
HTTPSMS_SIM_SLOT=

# --- AI analyst (Google Gemini) ---
# API key from Google AI Studio. Leave blank to turn AI features off.
GEMINI_API_KEY=
# Optional: model override. Defaults to gemini-3.5-flash-lite if blank.
GEMINI_MODEL=

# --- Password reset ---
# Random string, at least 32 characters. Keys the masked-number hint and the
# IP hash used by reset throttling. Missing/short: no hint shown, throttles still apply.
PASSWORD_RESET_HINT_KEY=

# --- Document generation ---
# Optional: path to LibreOffice soffice.exe if not in the default location.
LIBREOFFICE_PATH=

# --- Complaint photo storage ---
# Required for new complaint photos. Absolute path to a folder OUTSIDE the web root.
# Example: C:/laragon/private/BarangayLink/complaint_attachments
COMPLAINT_ATTACHMENT_STORAGE_DIR=
