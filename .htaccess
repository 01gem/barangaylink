# BarangayLink - web root access rules.
# Apache 2.4. This file is not applied by PHP's built-in server.

# No directory listings anywhere under the project.
Options -Indexes

# Dotfiles and dot-folders (.env, .git, .gitignore, .vscode) are never served.
<IfModule mod_alias.c>
  RedirectMatch 403 (?i)(^|/)\.(?!well-known/)
</IfModule>
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Database dumps, backups, logs, notes and maintenance scripts are never served.
<FilesMatch "(?i)\.(sql|bak|log|md|py|ps1|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# The full source snapshot is a local working file.
<Files "source-code.txt">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</Files>
