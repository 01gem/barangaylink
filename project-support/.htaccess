# Direct HTTP access to docs, migrations, scripts and tests is denied.
# Everything here is run from the command line only.
# Apache 2.4. This file is not applied by PHP's built-in server.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Deny from all
</IfModule>
