# Direct HTTP access to generated documents is denied.
# Signed-in officials read a request's PDF through api/requests/view_document.php.
# Apache 2.4. This file is not applied by PHP's built-in server.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Deny from all
</IfModule>
